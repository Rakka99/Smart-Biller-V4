NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://postgres:postgres@db:5432/pln_monitoring?schema=public
JWT_SECRET=replace-with-a-long-random-secret
CORS_ORIGIN=http://localhost:5173

IAK_BASE_URL=https://testpostpaid.mobilepulsa.net/api/v1/bill/check
IAK_USERNAME=your_registered_phone_number
IAK_API_KEY=your_iak_api_key
IAK_PLN_PRODUCT_CODE=PLNPOSTPAID

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-now

BILLING_TIMEZONE=Asia/Jakarta
# Optional demo override, e.g. 2026-08-25. Leave empty in production.
BILLING_AS_OF_DATE=

SUPERVISOR_EMAIL=supervisor@example.com
BILLER_EMAIL=biller@example.com
