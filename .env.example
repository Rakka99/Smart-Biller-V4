NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://postgres:postgres@db:5432/pln_monitoring?schema=public
JWT_SECRET=replace-with-a-long-random-secret
CORS_ORIGIN=http://localhost:5173

DIGIFLAZZ_BASE_URL=https://api.digiflazz.com/v1
DIGIFLAZZ_USERNAME=your_username
DIGIFLAZZ_API_KEY=your_api_key
DIGIFLAZZ_WEBHOOK_SECRET=your_webhook_secret
DIGIFLAZZ_PLN_SKU=pln
DIGIFLAZZ_TESTING=true

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-now

BILLING_TIMEZONE=Asia/Jakarta
# Optional demo override, e.g. 2026-08-25. Leave empty in production.
BILLING_AS_OF_DATE=

SUPERVISOR_EMAIL=supervisor@example.com
BILLER_EMAIL=biller@example.com
